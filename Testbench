`timescale 1ns/1ps

module mux8x1_tb;

reg [7:0] I;
reg [2:0] S;
wire Y;

// Instantiate the Unit Under Test (UUT)
mux8x1 uut (
    .I(I),
    .S(S),
    .Y(Y)
);

initial begin
    $dumpfile("mux8x1.vcd");
    $dumpvars(0, mux8x1_tb);

    $display("Time\tInputs\t\tSelect\tY");
    $monitor("%0t\t%b\t%b\t%b", $time, I, S, Y);

    // Input pattern
    I = 8'b10101100;

    S = 3'b000; #10;
    S = 3'b001; #10;
    S = 3'b010; #10;
    S = 3'b011; #10;
    S = 3'b100; #10;
    S = 3'b101; #10;
    S = 3'b110; #10;
    S = 3'b111; #10;

    $finish;
end

endmodule